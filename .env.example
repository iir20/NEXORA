# NEXORA — copy to .env and fill in real values. NEVER commit a real .env.
# All values below are placeholders or dev-only defaults.

# Required: PostgreSQL connection string.
DATABASE_URL=postgres://nexora:changeme@localhost:5432/nexora

# Server
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
CORS_ORIGINS=

# Sessions (days)
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=nx_session

# Password hashing cost (bcrypt rounds)
BCRYPT_ROUNDS=12

# 64 hex chars (32 bytes). REQUIRED in production; dev generates an ephemeral
# key (codes then don't survive restarts — by design).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODE_ENCRYPTION_KEY=

# Handover-code lifetime (hours) and max attempts
CODE_TTL_HOURS=24
CODE_MAX_ATTEMPTS=5

# Private file storage (local directory; S3 provider is documented, not wired)
STORAGE_DIR=./storage
STORAGE_PROVIDER=local
MAX_UPLOAD_MB=10

# Maps/geocoding provider. Empty = none configured (route endpoint returns 503).
MAPS_PROVIDER=

# Rate-limit overrides (defaults: auth 10/min, messages 30/min, uploads 20/min,
# deliveries 60/hour, api 300/min). Only used to relax limits in tests.
# AUTH_RATE_LIMIT_MAX=
# MESSAGE_RATE_LIMIT_MAX=
